{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:determinagent:contracts:v1:request",
  "title": "DeterminAgent v1 typed request",
  "description": "Everything that enters the pipeline. The task field and the payload must agree; the router still verifies the route.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "task", "submitted_at", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/id" },
    "task": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/task" },
    "submitted_at": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/timestamp" },
    "domain": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/term" },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "task": { "const": "rulespeak_generation" } } },
      "then": { "properties": { "payload": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/rulespeak_generation_input" } } }
    },
    {
      "if": { "properties": { "task": { "const": "rulespeak_validation" } } },
      "then": { "properties": { "payload": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/rulespeak_validation_input" } } }
    },
    {
      "if": { "properties": { "task": { "const": "gherkin_requirements" } } },
      "then": { "properties": { "payload": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/gherkin_requirements_input" } } }
    },
    {
      "if": { "properties": { "task": { "const": "js_advice" } } },
      "then": { "properties": { "payload": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/js_advice_input" } } }
    },
    {
      "if": { "properties": { "task": { "const": "js_generation" } } },
      "then": { "properties": { "payload": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/js_generation_input" } } }
    },
    {
      "if": { "properties": { "task": { "const": "js_correction" } } },
      "then": { "properties": { "payload": { "$ref": "urn:determinagent:contracts:v1:common#/$defs/js_correction_input" } } }
    }
  ]
}
