{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:determinagent:contracts:v1:common",
  "title": "DeterminAgent v1 shared definitions",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "task": {
      "description": "The POC tasks: the router's target and the golden set's expected route. The js_ tasks are J1 advise, J2 generate and J3 correct; J2 ships first.",
      "enum": ["rulespeak_generation", "rulespeak_validation", "gherkin_requirements", "js_advice", "js_generation", "js_correction"]
    },
    "short_text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "long_text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\n]+$"
    },
    "vocabulary": {
      "description": "Agreed business terms (the fact model). Supplied by the caller; a term string occurring in a statement does not prove the term is agreed.",
      "type": "array",
      "items": { "$ref": "#/$defs/term" },
      "uniqueItems": true,
      "maxItems": 200
    },
    "rs_ref": { "type": "string", "pattern": "^RS-[0-9]{2}$" },
    "rs_refs": { "type": "array", "items": { "$ref": "#/$defs/rs_ref" }, "uniqueItems": true },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "timestamp": { "type": "string", "format": "date-time" },

    "constraint_type": {
      "description": "Which kind of guidance the intent asks for. Maps to the RuleSpeak template families. 'unknown' lets the router or the SLM decide.",
      "enum": [
        "obligation",
        "prohibition",
        "restricted_permission",
        "restricted_eligibility",
        "classification",
        "computation",
        "procedure",
        "advice_permission",
        "advice_exemption",
        "unknown"
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {
          "description": "if: applies while it holds. when: applies at the named occurrence (RS-15). before/after: timing. unless: profile extension.",
          "enum": ["if", "when", "before", "after", "unless"]
        },
        "text": { "$ref": "#/$defs/short_text" }
      }
    },
    "intent": {
      "description": "Business intent for one constraint. Typed fields first; free_text is the exception and is required only when no typed field is given.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "constraint_type": { "$ref": "#/$defs/constraint_type" },
        "subject": { "$ref": "#/$defs/term" },
        "action": { "$ref": "#/$defs/short_text" },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "maxItems": 5 },
        "qualification": { "$ref": "#/$defs/short_text" },
        "free_text": { "$ref": "#/$defs/short_text" }
      },
      "anyOf": [{ "required": ["free_text"] }, { "required": ["subject", "action"] }]
    },
    "requirement": {
      "description": "A user requirement for Gherkin generation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["capability"],
      "properties": {
        "role": { "$ref": "#/$defs/short_text" },
        "capability": { "$ref": "#/$defs/short_text" },
        "benefit": { "$ref": "#/$defs/short_text" },
        "acceptance_criteria": { "type": "array", "items": { "$ref": "#/$defs/short_text" }, "maxItems": 20 },
        "feature_name": { "$ref": "#/$defs/short_text" }
      }
    },

    "rulespeak_generation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "vocabulary"],
      "properties": {
        "intent": { "$ref": "#/$defs/intent" },
        "vocabulary": { "$ref": "#/$defs/vocabulary" },
        "source_ref": { "$ref": "#/$defs/short_text" }
      }
    },
    "rulespeak_validation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statements"],
      "properties": {
        "statements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "text"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "text": { "$ref": "#/$defs/short_text" },
              "intent": { "$ref": "#/$defs/intent", "description": "Independent statement of intent. Without it, fidelity is unverified." }
            }
          }
        },
        "vocabulary": { "$ref": "#/$defs/vocabulary" }
      }
    },
    "gherkin_requirements_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement"],
      "properties": {
        "requirement": { "$ref": "#/$defs/requirement" },
        "source_ref": { "$ref": "#/$defs/short_text" }
      }
    },

    "finding": {
      "description": "One diagnostic with its evidence chain. Same shape the RuleSpeak checker returns.",
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "kind", "disposition", "basis", "rs_refs", "source"],
      "properties": {
        "code": { "type": "string", "pattern": "^(RS|GK)-[A-Z]+-[0-9]{3}$" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "kind": { "enum": ["form", "meaning", "style", "principle", "application", "profile", "local"] },
        "disposition": { "enum": ["error", "review", "warning", "info"] },
        "basis": { "enum": ["sourced", "inferred", "local", "model"] },
        "rs_refs": { "$ref": "#/$defs/rs_refs" },
        "source": { "type": "array", "items": { "type": "string" } }
      }
    },
    "trace_entry": {
      "description": "One line of the response trace: a claim, the RS ids behind it and how they apply (RuleSpeak-Agent.md response contract, step 3).",
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "rs_refs", "application"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "rs_refs": { "$ref": "#/$defs/rs_refs" },
        "source": { "type": "array", "items": { "type": "string" } },
        "application": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "description": "A clarifying question, returned instead of guessing a missing business decision.",
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "$ref": "#/$defs/short_text" },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/short_text" }, "maxItems": 5 },
        "rs_refs": { "$ref": "#/$defs/rs_refs" }
      }
    },
    "rulespeak_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "guidance_type", "template_id", "trace"],
      "properties": {
        "text": { "$ref": "#/$defs/short_text" },
        "guidance_type": { "enum": ["rule", "advice"] },
        "template_id": { "type": "string", "pattern": "^RS-T[0-9]{2}b?$" },
        "assumptions": { "type": "array", "items": { "$ref": "#/$defs/short_text" } },
        "trace": { "type": "array", "items": { "$ref": "#/$defs/trace_entry" }, "minItems": 1 }
      }
    },
    "vocabulary_proposal": {
      "description": "A business term the response proposes to add to the closed vocabulary. A statement that uses it holds only once the user confirms the term (RS-VOC-002).",
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "definition"],
      "properties": {
        "term": { "$ref": "#/$defs/term" },
        "definition": { "$ref": "#/$defs/short_text" },
        "rationale": { "$ref": "#/$defs/short_text" }
      }
    },
    "rulespeak_generation_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statements", "questions"],
      "properties": {
        "statements": { "type": "array", "items": { "$ref": "#/$defs/rulespeak_statement" } },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
        "vocabulary_proposals": { "type": "array", "items": { "$ref": "#/$defs/vocabulary_proposal" }, "maxItems": 20 }
      },
      "anyOf": [
        { "properties": { "statements": { "minItems": 1 } } },
        { "properties": { "questions": { "minItems": 1 } } }
      ]
    },
    "rulespeak_validation_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["results"],
      "properties": {
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement_id", "form", "fidelity", "findings"],
            "properties": {
              "statement_id": { "$ref": "#/$defs/id" },
              "form": { "enum": ["conforms", "needs_revision", "undetermined"] },
              "fidelity": { "enum": ["preserved", "changed", "unverified"] },
              "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
              "suggested_rewrites": { "type": "array", "items": { "$ref": "#/$defs/rulespeak_statement" } },
              "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
            }
          }
        }
      }
    },
    "gherkin_requirements_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions"],
      "properties": {
        "feature": { "$ref": "#/$defs/long_text", "description": "One Gherkin document. Must pass the Gherkin profile." },
        "covered_criteria": {
          "description": "For each acceptance criterion (by index), the scenario names that cover it.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "scenarios"],
            "properties": {
              "criterion": { "type": "integer", "minimum": 0 },
              "scenarios": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "questions": { "type": "array", "items": { "$ref": "#/$defs/question" } }
      },
      "anyOf": [{ "required": ["feature"] }, { "properties": { "questions": { "minItems": 1 } } }]
    },

    "js_identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_$][A-Za-z0-9_$]{0,63}$"
    },
    "js_type": {
      "description": "A JSDoc type expression, such as number, string[] or {id: string, qty: number}.",
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "code_text": {
      "description": "JavaScript source. About 200 lines at most (the JS profile's scope).",
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "js_source": {
      "description": "One ES module (ES2022+, Node 20+, standard library only).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/code_text"
        },
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}\\.m?js$"
        }
      }
    },
    "js_function_spec": {
      "description": "J2 input: a typed function spec. Examples are visible to the model; the golden set's hidden tests are not part of the request.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "params",
        "returns",
        "behavior"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/js_identifier"
        },
        "export": {
          "enum": [
            "named",
            "default"
          ],
          "default": "named"
        },
        "async": {
          "type": "boolean",
          "default": false
        },
        "params": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/js_identifier"
              },
              "type": {
                "$ref": "#/$defs/js_type"
              },
              "description": {
                "$ref": "#/$defs/short_text"
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        },
        "returns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/js_type"
            },
            "description": {
              "$ref": "#/$defs/short_text"
            }
          }
        },
        "behavior": {
          "$ref": "#/$defs/long_text"
        },
        "examples": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "description": "One call: args in order, then either the expected return value or the error it throws.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "args"
            ],
            "properties": {
              "args": {
                "type": "array"
              },
              "returns": {},
              "throws": {
                "$ref": "#/$defs/short_text"
              }
            },
            "oneOf": [
              {
                "required": [
                  "returns"
                ]
              },
              {
                "required": [
                  "throws"
                ]
              }
            ]
          }
        },
        "constraints": {
          "description": "For example: no recursion; O(n) time; do not mutate the input.",
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/short_text"
          }
        }
      }
    },
    "js_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_line",
        "end_line"
      ],
      "properties": {
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_column": {
          "type": "integer",
          "minimum": 1
        },
        "end_column": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "js_finding": {
      "description": "One JavaScript diagnostic. Parser and lint findings come from the JS checker and are taken as given; basis model marks a finding an SLM adds.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "basis",
        "message",
        "range"
      ],
      "properties": {
        "code": {
          "description": "A code from the JS defect taxonomy (0.1).",
          "type": "string",
          "pattern": "^JS-[A-Z]+-[0-9]{3}$"
        },
        "rule": {
          "description": "The ESLint rule id, for lint findings.",
          "type": "string",
          "maxLength": 100
        },
        "category": {
          "enum": [
            "syntax",
            "correctness",
            "security",
            "performance",
            "readability",
            "idiom",
            "design"
          ]
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "basis": {
          "enum": [
            "parser",
            "lint",
            "test",
            "model"
          ]
        },
        "message": {
          "$ref": "#/$defs/short_text"
        },
        "range": {
          "$ref": "#/$defs/js_range"
        },
        "suggestion": {
          "$ref": "#/$defs/long_text"
        }
      }
    },
    "js_failure": {
      "description": "J3 input: the signal that the code is wrong.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "message"
      ],
      "properties": {
        "kind": {
          "enum": [
            "test_failure",
            "runtime_error",
            "lint_finding"
          ]
        },
        "message": {
          "$ref": "#/$defs/long_text"
        },
        "test_name": {
          "$ref": "#/$defs/short_text"
        },
        "error_type": {
          "$ref": "#/$defs/js_identifier"
        },
        "stack": {
          "$ref": "#/$defs/long_text"
        },
        "finding": {
          "$ref": "#/$defs/js_finding"
        }
      }
    },
    "js_execution": {
      "description": "What the 0.8 sandbox reports for one module. Filled by the sandbox, never by the model.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parsed",
        "lint",
        "tests",
        "violations",
        "environment"
      ],
      "properties": {
        "parsed": {
          "type": "boolean"
        },
        "lint": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/js_finding"
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "status"
            ],
            "properties": {
              "name": {
                "$ref": "#/$defs/short_text"
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "skip",
                  "timeout"
                ]
              },
              "duration_ms": {
                "type": "number",
                "minimum": 0
              },
              "message": {
                "$ref": "#/$defs/long_text"
              }
            }
          }
        },
        "violations": {
          "description": "Attempts the sandbox blocked or limits it enforced. Any entry fails the gate.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "network",
              "filesystem",
              "process",
              "timeout",
              "memory",
              "nondeterminism"
            ]
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_version",
            "profile_version"
          ],
          "properties": {
            "node_version": {
              "type": "string",
              "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "profile_version": {
              "$ref": "#/$defs/semver"
            },
            "timeout_ms": {
              "type": "integer",
              "minimum": 1
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 1
            },
            "clock": {
              "$ref": "#/$defs/timestamp"
            },
            "seed": {
              "type": "integer"
            }
          }
        }
      }
    },
    "js_advice_input": {
      "description": "J1 (tranche 2): advise on code.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/js_source"
        },
        "focus": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "correctness",
              "security",
              "performance",
              "readability",
              "idiom",
              "design"
            ]
          }
        },
        "question": {
          "$ref": "#/$defs/short_text"
        }
      }
    },
    "js_advice_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings",
        "questions"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/js_finding"
          }
        },
        "answer": {
          "$ref": "#/$defs/long_text"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      }
    },
    "js_generation_input": {
      "description": "J2 (tranche 1): generate a module from a function spec.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec"
      ],
      "properties": {
        "spec": {
          "$ref": "#/$defs/js_function_spec"
        }
      }
    },
    "js_generation_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questions"
      ],
      "properties": {
        "module": {
          "$ref": "#/$defs/js_source"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/short_text"
          }
        },
        "execution": {
          "$ref": "#/$defs/js_execution"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "module"
          ]
        },
        {
          "properties": {
            "questions": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "js_correction_input": {
      "description": "J3 (tranche 2): correct code given a failure signal.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "failure"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/js_source"
        },
        "failure": {
          "$ref": "#/$defs/js_failure"
        },
        "tests": {
          "description": "Visible tests, if the caller has them.",
          "$ref": "#/$defs/js_source"
        },
        "spec": {
          "$ref": "#/$defs/js_function_spec"
        }
      }
    },
    "js_correction_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questions"
      ],
      "properties": {
        "module": {
          "description": "The corrected module. It is what the sandbox runs.",
          "$ref": "#/$defs/js_source"
        },
        "patch": {
          "description": "Unified diff from the input source, for review. Derived from module.",
          "$ref": "#/$defs/code_text"
        },
        "explanation": {
          "$ref": "#/$defs/long_text"
        },
        "execution": {
          "$ref": "#/$defs/js_execution"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "module"
          ]
        },
        {
          "properties": {
            "questions": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "reason_code": {
      "description": "Why a request ended Rejected or Violated. Stable codes; add, never repurpose.",
      "enum": [
        "SCHEMA_INVALID",
        "PAYLOAD_TASK_MISMATCH",
        "UNSUPPORTED_SCHEMA_VERSION",
        "NO_ROUTE",
        "INPUT_TOO_LARGE",
        "OUTPUT_SCHEMA_INVALID",
        "OUTPUT_NONCONFORMANT",
        "MODEL_ERROR",
        "MODEL_TIMEOUT",
        "POLICY_VIOLATION",
        "SANDBOX_VIOLATION",
        "SANDBOX_TIMEOUT"
      ]
    },
    "exit_status": {
      "description": "Phase 2.2 taxonomy. Resolved: completed and passed output validation. Rejected: refused by a validator or the router. Violated: completed but broke a contract or policy.",
      "enum": ["resolved", "rejected", "violated"]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "rule_id", "config_version"],
      "properties": {
        "tier": { "enum": ["reflex", "lookup", "pattern", "fallback", "none"] },
