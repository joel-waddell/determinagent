{
  "name": "determinagent",
  "version": "0.0.1",
  "description": "Deterministic routing of typed requests to specialized small language models, improved offline from execution traces.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./js/src/index.js",
    "./conformance/rulespeak": "./js/src/conformance/rulespeak.js",
    "./conformance/gherkin": "./js/src/conformance/gherkin.js",
    "./contracts": "./js/src/contracts.js"
  },
  "bin": {
    "determinagent": "./js/bin/determinagent.js"
  },
  "files": [
    "js/bin",
    "js/src",
    "src/determinagent/spec/*.yaml",
    "src/determinagent/contracts/v1/*.json"
  ],
  "scripts": {
    "test": "node --test js/test/*.test.js",
    "lint": "eslint js"
  },
  "dependencies": {
    "@cucumber/gherkin": "^43.0.0",
    "@cucumber/messages": "^35.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0"
  }
}
